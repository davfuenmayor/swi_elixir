# Aleph: learn a rule and test it on new examples

```elixir
Mix.install([
  {:swi_elixir, github: "davfuenmayor/swi_elixir", branch: "main"},
  {:kino, "== 0.19.0"}
])

project = Path.join(Mix.install_project_dir(), "deps/swi_elixir")

Code.require_file(Path.join(project, "examples/ilp.exs"))

engine = Path.join(project, "vendor/aleph/aleph.pl")
engine_import = ":- use_module(" <> IO.iodata_to_binary(:json.encode(engine)) <> ")."

adapter = ~S"""
:- module(aleph_ilp, [learn_task/8]).
""" <> engine_import <> "\n" <> ~S"""
:- use_module(ilp_support).

lesson(trains, aleph_trains, eastbound(_)).
lesson(membership, aleph_membership, mem(_,_)).

% Re-read the task for each experiment: Aleph consumes examples and updates its
% background during induction. Serialize reconsult/search in the shared NIF VM.
learn_task(Task, Length, ProgramText, Rows, Clauses, Trace, Path, Tests) :-
    must_be(integer, Length), between(1,6,Length),
    lesson(Task, Module, Target),
    with_mutex(aleph_ilp,
      setup_call_cleanup(
        load_task_source(Module, Path),
        with_output_to(string(Trace),
        (Module:aleph_set(clauselength, Length),
         Module:aleph_set(noise, 0), Module:aleph_set(nodes, 5000),
         once(Module:induce(Program)),
         length(Program, Clauses), program_text(Program, ProgramText),
         findall(P, Module:example(_,pos,P), Pos),
         findall(N, Module:example(_,neg,N), Neg),
         evaluate(Module, Pos, Neg, Tests, Rows))),
        cleanup(Module, Target))).

load_task_source(Module, Path) :-
    forall((source_file(Module:_, Loaded), file_base_name(Loaded, Name),
            memberchk(Name, ['aleph_trains.pl','aleph_membership.pl']),
            Loaded \== Path), unload_file(Loaded)),
    load_files(Path, [if(true)]).

cleanup(Module, Target) :-
    retractall(Module:Target),
    % Aleph initializes zero-arity command shims with assert/1. Reconsult does
    % not replace those clauses; remove our private modules' generated shims.
    forall((predicate_property(Module:Head, dynamic), functor(Head,_,0),
            \+ predicate_property(Module:Head, imported_from(_)),
            clause(Module:Head, _, Ref), \+ clause_property(Ref, file(_))),
           erase(Ref)).
"""

evaluation = ~S"""
% Project-authored display and evaluation helpers; no learning algorithm here.
:- module(ilp_support, [program_text/2, evaluate/5, with_program/3]).
:- meta_predicate with_program(+, +, 0).

program_text(Program, Text) :-
    with_output_to(string(Text), maplist(portray_clause, Program)).

% Reference-based cleanup leaves background knowledge intact, including on error.
with_program(Module, Program, Goal) :-
    setup_call_cleanup(
      findall(Ref, (member(Clause, Program), assertz(Module:Clause, Ref)), Refs),
      Goal,
      maplist(erase, Refs)).

evaluate(Module, Pos, Neg, Tests, Rows) :-
    findall(result(Split, Text, Expected, Actual),
      (example(Pos, Neg, Tests, Split, Goal, Expected),
       with_output_to(string(Text), write_term(Goal, [quoted(true)])),
       (once(Module:Goal) -> Actual = true ; Actual = false)), Rows).

example(Pos, _, _, train, Goal, true) :- member(Goal, Pos).
example(_, Neg, _, train, Goal, false) :- member(Goal, Neg).
example(_, _, Tests, test, Goal, Expected) :- member(Goal-Expected, Tests).
"""

learn = fn task, limit, source, checks, selected ->
  file = if task == :trains, do: "aleph_trains.pl", else: "aleph_membership.pl"
  [module, body] = String.split(source, "\n", parts: 2)
  task_source = Enum.join([module, engine_import, body], "\n")

  files = %{
    "ilp_support.pl" => evaluation,
    "aleph_ilp.pl" => adapter,
    file => task_source
  }

  ILPShowcase.run_inline(selected, files, ["aleph_ilp.pl"], fn directory ->
    path = :json.encode(Path.join(directory, file)) |> IO.iodata_to_binary()

    tests = Enum.map_join(checks, ",", fn {goal, expected} -> "#{goal}-#{expected}" end)

    """
    statistics(inferences, Before),
    aleph_ilp:learn_task(#{task}, #{limit}, Program, Rows, Clauses, Trace, #{path}, [#{tests}]),
    statistics(inferences, After),
    Inferences is After - Before
    """
  end)
end

train_bias = ~S"""
:- module(aleph_trains, []).

:- aleph.
:-style_check(-discontiguous).
:- aleph_set(i,2).

:- modeh(1,eastbound(+train)).
"""

train_modes = [
  short: ["+car"],
  closed: ["+car"],
  long: ["+car"],
  open_car: ["+car"],
  double: ["+car"],
  jagged: ["+car"],
  shape: ["+car", "#shape"],
  load: ["+car", "#shape", "#int"],
  wheels: ["+car", "#int"],
  has_car: ["+train", "-car"]
]

train_background = ~S"""
car(car_11). car(car_12). car(car_13). car(car_14). car(car_21). car(car_22). car(car_23).
car(car_31). car(car_32). car(car_33). car(car_41). car(car_42). car(car_43). car(car_44).
car(car_51). car(car_52). car(car_53). car(car_61). car(car_62). car(car_71). car(car_72).
car(car_73). car(car_81). car(car_82). car(car_91). car(car_92). car(car_93). car(car_94).
car(car_101). car(car_102).

shape(elipse). shape(hexagon). shape(rectangle). shape(u_shaped). shape(triangle).
shape(circle). shape(nil).

train(east1). train(east2). train(east3). train(east4). train(east5). train(west6).
train(west7). train(west8). train(west9). train(west10).

short(car_12). closed(car_12). long(car_11). long(car_13). short(car_14).
open_car(car_11). open_car(car_13). open_car(car_14). shape(car_11,rectangle).
shape(car_12,rectangle). shape(car_13,rectangle). shape(car_14,rectangle).
load(car_11,rectangle,3). load(car_12,triangle,1). load(car_13,hexagon,1).
load(car_14,circle,1). wheels(car_11,2). wheels(car_12,2). wheels(car_13,3).
wheels(car_14,2). has_car(east1,car_11). has_car(east1,car_12). has_car(east1,car_13).
has_car(east1,car_14).

has_car(east2,car_21). has_car(east2,car_22). has_car(east2,car_23). short(car_21).
short(car_22). short(car_23). shape(car_21,u_shaped). shape(car_22,u_shaped).
shape(car_23,rectangle). open_car(car_21). open_car(car_22). closed(car_23).
load(car_21,triangle,1). load(car_22,rectangle,1). load(car_23,circle,2).
wheels(car_21,2). wheels(car_22,2). wheels(car_23,2).

has_car(east3,car_31). has_car(east3,car_32). has_car(east3,car_33). short(car_31).
short(car_32). long(car_33). shape(car_31,rectangle). shape(car_32,hexagon).
shape(car_33,rectangle). open_car(car_31). closed(car_32). closed(car_33).
load(car_31,circle,1). load(car_32,triangle,1). load(car_33,triangle,1). wheels(car_31,2).
wheels(car_32,2). wheels(car_33,3).

has_car(east4,car_41). has_car(east4,car_42). has_car(east4,car_43).
has_car(east4,car_44). short(car_41). short(car_42). short(car_43). short(car_44).
shape(car_41,u_shaped). shape(car_42,rectangle). shape(car_43,elipse).
shape(car_44,rectangle). double(car_42). open_car(car_41). open_car(car_42).
closed(car_43). open_car(car_44). load(car_41,triangle,1). load(car_42,triangle,1).
load(car_43,rectangle,1). load(car_44,rectangle,1). wheels(car_41,2). wheels(car_42,2).
wheels(car_43,2). wheels(car_44,2).

has_car(east5,car_51). has_car(east5,car_52). has_car(east5,car_53). short(car_51).
short(car_52). short(car_53). shape(car_51,rectangle). shape(car_52,rectangle).
shape(car_53,rectangle). double(car_51). open_car(car_51). closed(car_52). closed(car_53).
load(car_51,triangle,1). load(car_52,rectangle,1). load(car_53,circle,1).
wheels(car_51,2). wheels(car_52,3). wheels(car_53,2).

has_car(west6,car_61). has_car(west6,car_62). long(car_61). short(car_62).
shape(car_61,rectangle). shape(car_62,rectangle). closed(car_61). open_car(car_62).
load(car_61,circle,3). load(car_62,triangle,1). wheels(car_61,2). wheels(car_62,2).

has_car(west7,car_71). has_car(west7,car_72). has_car(west7,car_73). short(car_71).
short(car_72). long(car_73). shape(car_71,rectangle). shape(car_72,u_shaped).
shape(car_73,rectangle). double(car_71). open_car(car_71). open_car(car_72).
jagged(car_73). load(car_71,circle,1). load(car_72,triangle,1). load(car_73,nil,0).
wheels(car_71,2). wheels(car_72,2). wheels(car_73,2).

has_car(west8,car_81). has_car(west8,car_82). long(car_81). short(car_82).
shape(car_81,rectangle). shape(car_82,u_shaped). closed(car_81). open_car(car_82).
load(car_81,rectangle,1). load(car_82,circle,1). wheels(car_81,3). wheels(car_82,2).

has_car(west9,car_91). has_car(west9,car_92). has_car(west9,car_93).
has_car(west9,car_94). short(car_91). long(car_92). short(car_93). short(car_94).
shape(car_91,u_shaped). shape(car_92,rectangle). shape(car_93,rectangle).
shape(car_94,u_shaped). open_car(car_91). jagged(car_92). open_car(car_93).
open_car(car_94). load(car_91,circle,1). load(car_92,rectangle,1).
load(car_93,rectangle,1). load(car_93,circle,1). wheels(car_91,2). wheels(car_92,2).
wheels(car_93,2). wheels(car_94,2).

has_car(west10,car_101). has_car(west10,car_102). short(car_101). long(car_102).
shape(car_101,u_shaped). shape(car_102,rectangle). open_car(car_101). open_car(car_102).
load(car_101,rectangle,1). load(car_102,rectangle,2). wheels(car_101,2).
wheels(car_102,2).

"""

membership_source = ~S"""
:- module(aleph_membership, []).
:- aleph.

:- mode(*,mem(+any,+list)).
:- mode(1,((+list) = ([-any|-list]))).

:- aleph_set(i,3).
:- aleph_set(noise,0).


:- determination(mem/2,mem/2).
:- determination(mem/2,'='/2).

:-begin_bg.

:-end_bg.
"""

label_source = fn yes, no ->
  positive = Enum.map_join(yes, "\n", &"#{&1}.")
  negative = Enum.map_join(no, "\n", &"#{&1}.")

  """
  :- begin_in_pos.
  #{positive}
  :- end_in_pos.
  :- begin_in_neg.
  #{negative}
  :- end_in_neg.
  """
end

trains_task = fn yes, no, new_trains, features ->
  declarations =
    for {name, args} <- train_modes, name in features do
      recall = if name == :has_car, do: "*", else: "1"

      """
      :- modeb(#{recall}, #{name}(#{Enum.join(args, ",")})).
      :- determination(eastbound/1, #{name}/#{length(args)}).
      """
    end

  new_facts =
    Enum.map_join(new_trains, "\n", fn {train, cars, _expected} ->
      car_facts =
        cars
        |> Enum.with_index(1)
        |> Enum.map_join("\n", fn {{size, cover}, index} ->
          car = "#{train}_car#{index}"
          "car(#{car}). has_car(#{train},#{car}). #{size}(#{car}). #{cover}(#{car})."
        end)

      "train(#{train}).\n#{car_facts}"
    end)

  train_bias <> Enum.join(declarations) <> "\n:- begin_bg.\n" <> train_background <> "\n" <> new_facts <>
    "\n:- end_bg.\n" <>
    label_source.(Enum.map(yes, &"eastbound(#{&1})"), Enum.map(no, &"eastbound(#{&1})"))
end


show = fn result ->
  program = result["Program"]

  if program == "" do
    Kino.Text.new("No rule found within this limit.")
  else
    {training, checks} = Enum.split_with(result["Rows"], &(&1.split == "train"))
    matches = Enum.count(training, &(&1.expected == &1.actual))

    rows =
      for %{goal: goal, expected: expected, actual: actual} <- checks do
        %{
          "Example" => goal,
          "Expected" => if(expected, do: "Yes", else: "No"),
          "Predicted" => if(actual, do: "Yes", else: "No")
        }
      end

    Kino.Layout.grid(
      [
        Kino.Text.new(program),
        Kino.Markdown.new("**Training examples matched:** #{matches} of #{length(training)}"),
        Kino.DataTable.new(rows, name: "New examples", keys: ["Example", "Expected", "Predicted"])
      ],
      columns: 1
    )
  end
end


Kino.nothing()
```

## Introduction

A train can have several cars. Each car has properties such as length,
shape, and whether it is open or closed. Can you find a rule that explains
which trains go east? Give [Aleph](https://github.com/friguzzi/aleph) the
same clues and see what rule it learns.

Run **Setup**, then work down one cell at a time. Keep `:port` for a separate SWI
process or choose `:nif` to run SWI inside Livebook.

Choose which facts Aleph may use in a rule. `has_car` lets it find a car
belonging to a train. `short` and `closed` let it ask two questions about
that car. Aleph calls declarations about how to use these relations
**modes**. For instance, `has_car(+train,-car)` starts with a known train
and introduces a car to examine.

```elixir
backend = :port
train_features = ~w(short closed long open_car double jagged shape load wheels has_car)a
Kino.nothing()
```

The notebook turns this list into mode declarations, loads the facts and
training labels into SWI, and asks Aleph for a program with `induce(Program)`.
The checks then run that program on new trains.

## Learn a rule for eastbound trains

Aleph gets facts about ten trains and their cars, plus the direction labels
below. For example, `east1` has a short, closed car. So does `east2`.
`west6` has a long, closed car and a different car that is short and open.
What would a rule need to say to tell these trains apart?

The four checks describe new trains. Each lists the cars with their sizes
and covers, followed by the expected answer. Look at `probe_split`. It
has a short car and a closed car. Should it count as eastbound?

```elixir
eastbound = ~w(east1 east2 east3 east4 east5)
westbound = ~w(west6 west7 west8 west9 west10)

new_trains = [
  {:probe_yes, [{:short, :closed}], true},
  {:probe_long, [{:long, :closed}], false},
  {:probe_open, [{:short, :open_car}], false},
  {:probe_split, [{:short, :open_car}, {:long, :closed}], false}
]

train_checks = for {train, _cars, expected} <- new_trains, do: {"eastbound(#{train})", expected}
train_source = trains_task.(eastbound, westbound, new_trains, train_features)
trains = learn.(:trains, 4, train_source, train_checks, backend)
show.(trains)
```

Read the learned clause as “a train goes east if it has a car that is short
and closed.” Prolog uses the **same car variable** for both properties.
Follow that variable through the rule. Which car would you bind it to
for `probe_split`? The prediction table shows what happens when SWI runs
the rule on each example.

**Expected** comes from the labels you supplied for the new trains.
**Predicted** comes from running the learned program. Try closing the
short car in `probe_split`. Predict the answer, update its label, and
rerun the cell. The training labels stay the same.

## See what memorizing looks like

The `4` above limits how many parts can appear in one clause. The eastbound
rule needs four. It names the target and checks that the train has a car,
that the car is short, and that the same car is closed.

Reduce the limit to three. Aleph can still remember each eastbound train
by name. Before running, predict which new train this change will affect.

```elixir
max_parts = 3
memorized = learn.(:trains, max_parts, train_source, train_checks, backend)
show.(memorized)
```

Compare the two tables. Both programs answer all ten training examples
correctly. The program made of individual facts misses `probe_yes`. A
perfect training score can hide a rule that does poorly on new cases.
This is an example of **overfitting**.

Try changing `max_parts` back to `4`. Which facts does the recovered rule
use to recognize the new train?

## Learn when a list contains an item

Now give Aleph examples of `mem(Item, List)`. The **yes** examples cover
items at the start and farther into a list. The **no** examples include
absent items and empty lists. The learner can split a list into its first
item and the rest, and it is allowed to call the rule it is learning.

How would you decide whether `z` occurs in `[a,b,c,d,e,z]` if you could
look at only the first item at each step?

```elixir
present = [
  "mem(0,[0])", "mem(1,[1])", "mem(2,[2])", "mem(3,[3])", "mem(4,[4])",
  "mem(0,[0,0])", "mem(0,[0,1])", "mem(0,[0,2])", "mem(1,[0,1])",
  "mem(0,[1,0])", "mem(0,[2,0])", "mem(1,[1,1])", "mem(1,[2,1])",
  "mem(1,[1,2])", "mem(2,[2,2])", "mem(2,[3,2])", "mem(2,[2,3])",
  "mem(3,[2,3])", "mem(3,[4,2,3])"
]
absent = ["mem(0,[1,2])", "mem(0,[1])", "mem(1,[0])", "mem(3,[])", "mem(2,[])", "mem(2,[3])"]

list_checks = [
  {"mem(z,[a,b,c,d,e,z])", true},
  {"mem(z,[a,b,c])", false},
  {"mem(a,[])", false},
  {"mem(a,[a,a])", true}
]

list_source = membership_source <> "\n" <> label_source.(present, absent)
membership = learn.(:membership, 4, list_source, list_checks, backend)
show.(membership)
```

Read `[First|Rest]` as “first item, then the rest.” One clause finds the
item at the front. The other asks the same question of the rest of the list.
This is **recursion**. Each call works on a shorter list, and both clauses
fail on the empty list.

Try a check where the target appears twice, or immediately before the end.
Decide the expected answer before running it.

