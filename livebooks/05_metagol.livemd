  |> Base.decode64!(ignore: :whitespace)
  |> :zlib.gunzip()

run_inline = fn backend, files, entries, goal ->
  directory = Path.join(System.tmp_dir!(), "swi-ilp-#{System.pid()}")
  File.mkdir_p!(directory)

  try do
    for {name, source} <- files, do: File.write!(Path.join(directory, name), source)
    {:ok, session} = SWI.start_link(backend: backend)

    try do
      for name <- entries, do: :ok = SWI.load(session, Path.join(directory, name))
      [result] = SWI.query(session, goal.(directory), timeout: 15_000) |> Enum.to_list()
      true = result["Inferences"] > 0

      rows =
        for {:compound, "result", [{:atom, split}, goal, {:atom, expected}, {:atom, actual}]} <-
              result["Rows"] do
          %{split: split, goal: goal, expected: expected == "true", actual: actual == "true"}
        end

      Map.put(result, "Rows", rows)
    after
      SWI.stop(session)
    end
  after
    File.rm_rf!(directory)
  end
end

adapter = ~S"""
:- module(metagol_ilp, [learn_task/7]).
:- use_module(metagol).
:- use_module(ilp_support).

% Upstream Metagol resolves primitives in user. Prefix these demonstration hooks.
user:mg_mother(A,B) :- metagol_tasks:mg_mother(A,B).
user:mg_father(A,B) :- metagol_tasks:mg_father(A,B).
user:mg_parent(A,B) :- metagol_tasks:mg_parent(A,B).
user:mg_tail(A,B) :- metagol_ilp:mg_tail(A,B).
user:mg_reverse(A,B) :- metagol_ilp:mg_reverse(A,B).

metarule(identity, [P,Q], [P,A,B], [[Q,A,B]]).
metarule(chain, [P,Q,R], [P,A,B], [[Q,A,C],[R,C,B]]).
metarule(tailrec, [P,Q], [P,A,B], [[Q,A,C],[P,C,B]]).
metarule(tohigherorder, [P,Q,F], [P,A,B], [[Q,A,B,F]]).
:- if(\+ clause(metagol:ibk([map,[],[],_],[],_), true)).
ibk([map,[],[],_], []).
ibk([map,[A|As],[B|Bs],F], [[F,A,B],[map,As,Bs,F]]).
:- endif.

% Runtime implementation of the interpreted map for executing learned clauses.
map([], [], _).
map([A|As], [B|Bs], F) :- call(F,A,B), map(As,Bs,F).
mg_tail([_|T], T).
mg_reverse(A,B) :- reverse(A,B).

% Task facts and examples are loaded separately by each consumer.

% These examples share Metagol's upstream registry. Serialize learning and restore
% user declarations/settings; the native runtime shares modules across sessions.
learn_task(Task, Limit, Status, ProgramText, Rows, Clauses, Trace) :-
    must_be(integer, Limit), between(1,6,Limit), metagol_tasks:primitives(Task, Primitives),
    with_mutex(metagol_ilp,
      setup_call_cleanup(
        (metagol:options, save_settings(Saved)),
        with_output_to(string(Trace),
        (configure(Primitives, Limit), metagol_tasks:training(Task, Pos, Neg), metagol_tasks:tests(Task, Tests),
         (once(metagol:learn(Pos, Neg, MetaProgram)) ->
           Status = learned,
           reverse(MetaProgram, Ordered),
           maplist(metagol:metasub_to_clause, Ordered, Program),
           length(Program, Clauses), program_text(Program, ProgramText),
           with_program(metagol_ilp, Program,
             evaluate(metagol_ilp, Pos, Neg, Tests, Rows))
         ; Status = no_hypothesis, Clauses = 0, ProgramText = "", Rows = []))),
        restore_settings(Saved))).

save_settings(settings(Body, Options, Functional)) :-
    findall(P, user:body_pred(P), Body),
    findall(O, (option_pattern(O), functor(O,N,A), current_predicate(metagol:N/A), call(metagol:O)), Options),
    (metagol:functional -> Functional = true ; Functional = false).
option_pattern(max_clauses(_)).
option_pattern(min_clauses(_)).
option_pattern(max_inv_preds(_)).

configure(Primitives, Limit) :-
    retractall(user:body_pred(_)),
    forall(member(P,Primitives), assertz(user:body_pred(P))),
    metagol:set_option(min_clauses(1)), metagol:set_option(max_clauses(Limit)),
    N is Limit-1, metagol:set_option(max_inv_preds(N)), retractall(metagol:functional).

restore_settings(settings(Body, Options, Functional)) :-
    retractall(user:body_pred(_)),
    forall(member(P,Body), assertz(user:body_pred(P))),
    forall(option_pattern(O), retractall(metagol:O)),
    forall(member(O,Options), assertz(metagol:O)),
    retractall(metagol:functional),
    (Functional == true -> assertz(metagol:functional) ; true).
"""

evaluation = ~S"""
% Project-authored display and evaluation helpers; no learning algorithm here.
:- module(ilp_support, [program_text/2, evaluate/5, with_program/3]).
:- meta_predicate with_program(+, +, 0).

program_text(Program, Text) :-
    with_output_to(string(Text), maplist(portray_clause, Program)).

% Reference-based cleanup leaves background knowledge intact, including on error.
with_program(Module, Program, Goal) :-
    setup_call_cleanup(
      findall(Ref, (member(Clause, Program), assertz(Module:Clause, Ref)), Refs),
      Goal,
      maplist(erase, Refs)).

evaluate(Module, Pos, Neg, Tests, Rows) :-
    findall(result(Split, Text, Expected, Actual),
      (example(Pos, Neg, Tests, Split, Goal, Expected),
       with_output_to(string(Text), write_term(Goal, [quoted(true)])),
       (once(Module:Goal) -> Actual = true ; Actual = false)), Rows).

example(Pos, _, _, train, Goal, true) :- member(Goal, Pos).
example(_, Neg, _, train, Goal, false) :- member(Goal, Neg).
example(_, _, Tests, test, Goal, Expected) :- member(Goal-Expected, Tests).
"""

learn = fn task, budget, source, selected ->
  files = %{
    "metagol.pl" => engine,
    "ilp_support.pl" => evaluation,
    "metagol_ilp.pl" => adapter,
    "metagol_tasks.pl" => source
  }

  run_inline.(selected, files, ["metagol_ilp.pl", "metagol_tasks.pl"], fn _ ->
    """
    statistics(inferences, Before),
    metagol_ilp:learn_task(#{task}, #{budget}, Status, Program, Rows, Clauses, Trace),
    statistics(inferences, After),
    Inferences is After - Before
    """
  end)
end

learn_from_examples = fn target, limit, input, relations, backend ->
  checks = Enum.map_join(input.checks, ",", fn {goal, expected} -> "#{goal}-#{expected}" end)

  source = """
  :- module(metagol_tasks, [primitives/2, training/3, tests/2]).
  #{Map.get(input, :facts, "")}
  primitives(#{target}, [#{Enum.join(relations, ",")}]).
  training(#{target}, [#{Enum.join(input.yes, ",")}], [#{Enum.join(input.no, ",")}]).
  tests(#{target}, [#{checks}]).
  """

  learn.(target, limit, source, backend)
end


show = fn result ->
  program = result["Program"]

  if program == "" do
    Kino.Text.new("No rule found within this limit.")
  else
    {training, checks} = Enum.split_with(result["Rows"], &(&1.split == "train"))
    matches = Enum.count(training, &(&1.expected == &1.actual))

    rows =
      for %{goal: goal, expected: expected, actual: actual} <- checks do
        %{
          "Example" => goal,
          "Expected" => if(expected, do: "Yes", else: "No"),
          "Predicted" => if(actual, do: "Yes", else: "No")
        }
      end

    Kino.Layout.grid(
      [
        Kino.Text.new(program),
        Kino.Markdown.new("**Training examples matched:** #{matches} of #{length(training)}"),
        Kino.DataTable.new(rows, name: "New examples", keys: ["Example", "Expected", "Predicted"])
      ],
      columns: 1
    )
  end
end


Kino.nothing()
```

## Introduction

If you know that Nora is Ivy's mother and Ivy is Leo's father, what makes Nora
Leo's grandparent? You can work it out from the family facts. In this notebook,
[Metagol](https://github.com/metagol/metagol) learns a rule that can do the same.

Run **Setup**, then work down one cell at a time. Keep `:port` for a separate SWI
process or choose `:nif` to run SWI inside Livebook.

First choose which relations Metagol can use. For the grandparent task it
gets mother and father facts. The `/2` means each relation takes two
arguments. One rule template, called a *metarule*, lets Metagol join
two relations through a shared person, such as Ivy in the example above.

```elixir
backend = :port

allowed_relations = %{
  grandparent: ["mg_mother/2", "mg_father/2"],
  ancestor: ["mg_parent/2"],
  droplasts: ["mg_tail/2", "mg_reverse/2"]
}

train = fn target, examples, max_clauses ->
  relations = Map.fetch!(allowed_relations, target)
  learn_from_examples.(target, max_clauses, examples, relations, backend)
end

Kino.nothing()
```

When you call `train`, the notebook loads those relations and settings
into SWI and calls Metagol's `learn(Yes, No, Program)`. SWI then runs the
learned program on the examples you saved for checking.

## Learn what a grandparent is

Give Metagol family facts and examples of queries that should answer **yes**
or **no**. In a fact like `mg_mother(nora,ivy)`, the mother comes first.
In a query like `grandparent(ann,amelia)`, the proposed grandparent comes first.

Only the `yes` and `no` examples guide learning. The `checks` are questions
for the learned program to answer afterward. Before running the cell, trace
the path from Nora to Leo and predict the answer.

Metagol can combine the supplied mother and father relations and name a
new relation of its own. The number `3` limits the program to three clauses.

```elixir
family = %{
  facts: """
  mg_mother(ann,amy). mg_mother(ann,andy). mg_mother(amy,amelia).
  mg_mother(linda,gavin). mg_mother(nora,ivy).
  mg_father(steve,amy). mg_father(steve,andy). mg_father(gavin,amelia).
  mg_father(andy,spongebob). mg_father(ivy,leo).
  """,
  yes: [
    "grandparent(ann,amelia)",
    "grandparent(steve,amelia)",
    "grandparent(ann,spongebob)",
    "grandparent(steve,spongebob)",
    "grandparent(linda,amelia)"
  ],
  no: ["grandparent(amy,amelia)"],
  checks: [
    {"grandparent(nora,leo)", true},
    {"grandparent(ann,gavin)", false},
    {"grandparent(ann,ann)", false}
  ]
}

grandparent = train.(:grandparent, family, 3)
show.(grandparent)
```

The first output is the learned Prolog program. Read `:-` as “if” and a
comma as “and.” Look for the helper called `grandparent_1`. Its two clauses
say that a mother or a father counts as a parent. The grandparent clause
uses the helper twice, with the same person in the middle. Metagol introduced
that helper while learning. This is called **predicate invention**.

Below the rules, you'll see how many training labels the program matches.
The table shows its answers to the new questions. **Expected** comes from
the labels you supplied. **Predicted** is the program's answer. Find the
row for Nora and Leo.

### Give the learner fewer rules

The `3` above is the maximum number of clauses Metagol can use. A clause
is a rule or a fact. Try the same examples with room for only two clauses.
Then change `2` back to `3` and rerun this cell.

```elixir
max_clauses = 2
smaller = train.(:grandparent, family, max_clauses)
show.(smaller)
```

With two clauses, this search finds no rule that fits the examples. The
three-clause program has room to define both kinds of parent and join two
parent steps.

## Follow a longer family tree

A grandparent is exactly two parent steps away. An ancestor can be one,
two, or many steps away. Give Metagol some short paths as examples, then
ask about a longer one. How could a two-clause program describe paths of
different lengths?

```elixir
family_tree = %{
  facts: """
  mg_parent(queen_victoria,edward_seventh).
  mg_parent(edward_seventh,george_fifth).
  mg_parent(george_fifth,george_sixth).
  mg_parent(george_sixth,elizabeth_second).
  mg_parent(queen_mother,elizabeth_second).
  mg_parent(elizabeth_second,prince_charles).
  mg_parent(prince_philip,prince_charles).
  mg_parent(prince_charles,prince_william).
  mg_parent(prince_charles,prince_harry).
  mg_parent(princess_diana,prince_william).
  mg_parent(princess_diana,prince_harry).
  mg_parent(prince_william,prince_george).
  """,
  yes: [
    "ancestor(elizabeth_second,prince_charles)",
    "ancestor(george_sixth,prince_harry)",
    "ancestor(queen_mother,prince_william)"
  ],
  no: [],
  checks: [
    {"ancestor(queen_victoria,prince_george)", true},
    {"ancestor(princess_diana,prince_george)", true},
    {"ancestor(prince_george,queen_victoria)", false},
    {"ancestor(queen_victoria,queen_victoria)", false}
  ]
}

ancestor = train.(:ancestor, family_tree, 2)
show.(ancestor)
```

One clause handles a direct parent. The other takes one parent step and
asks the same ancestor question again from there. That repeated call is
**recursion**. What happens when the question is asked in reverse?

## Apply a rule to each inner list

This time each example pairs an input with a proposed output.
`droplasts([[a,b,c]],[[b,c]])` is a **no** because dropping the last item
from `[a,b,c]` should leave `[a,b]`.

Metagol can reverse a list, remove its first item (`mg_tail`), and apply a
helper to each inner list (`map`). Try combining the first two operations
by hand before running the cell.

```elixir
nested_lists = %{
  yes: [
    "droplasts([[a,b,c],[d,e,f,g]],[[a,b],[d,e,f]])",
    "droplasts([[h,i],[j,k,l],[m,n,o,p]],[[h],[j,k],[m,n,o]])"
  ],
  no: ["droplasts([[a,b,c]],[[b,c]])"],
  checks: [
    {"droplasts([[q],[r,s,t,u,v],[]],[[],[r,s,t,u],[]])", false},
    {"droplasts([[q],[r,s,t,u,v]],[[],[r,s,t,u]])", true},
    {"droplasts([],[])", true},
    {"droplasts([[x,y]],[[y]])", false}
  ]
}

droplasts = train.(:droplasts, nested_lists, 3)
show.(droplasts)
```

Follow the rule for a single list. Reverse `[a,b,c]` to `[c,b,a]`, remove
`c`, and reverse again to get `[a,b]`. Look for the `map` clause that applies
this procedure to every inner list. Why does the check with an empty inner
list fail while the check with an empty outer list succeeds?

Try adding a check for a singleton inner list. Decide the expected answer
before running it. Changing a check leaves the training examples as they are.

